# Copy to .env and adjust. .env is gitignored.
#
# Phase 2a: MinIO is the only storage backend. There is no local-FS fallback;
# `docker compose up -d` must be running before any ingestion or training.

# --- MinIO (S3-compatible local object store) ---
# Used by ingestion/storage.py to write bronze JSON.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=weather-lake
MINIO_REGION=us-east-1

# --- S3 client (same MinIO, different env-var names) ---
# Used by ml/dataset.py + ingestion/coverage.py to read gold parquet via pyarrow.
# Keep these in sync with the MINIO_* values above (they point at the same server).
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# --- Postgres (Gold warehouse) ---
POSTGRES_USER=weather
POSTGRES_PASSWORD=weather
POSTGRES_DB=weather_dw
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Ingestion settings ---
OPENMETEO_BASE_URL=https://archive-api.open-meteo.com/v1/archive
OPENMETEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast

# --- Region (Armenia bounding box, used by ingestion/grid.py) ---
REGION_NAME=armenia
GRID_LAT_MIN=38.84
GRID_LAT_MAX=41.30
GRID_LON_MIN=43.45
GRID_LON_MAX=46.63
GRID_SIZE=10
